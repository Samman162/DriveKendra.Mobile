# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code and config files (LF)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sh text eol=lf
*.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts (CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Vector images
*.svg text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.keystore binary
*.jks binary
*.p8 binary
*.p12 binary
*.key binary
*.mobileprovision binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.apk binary
*.aab binary
*.ipa binary
*.zip binary
*.tar.gz binary
